{
  "Firestore": {
    "ProjectId": "ecocycle-e9c04",
    "KeyPath": "firebase-key.json"
  },
  "AllowedOrigins": "http://localhost:4200",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}